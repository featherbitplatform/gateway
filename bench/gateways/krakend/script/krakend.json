{
  "version": 3,
  "port": 8000,
  "timeout": "10s",
  "output_encoding": "no-op",
  "max_idle_connections_per_host": 512,
  "idle_connection_timeout": "300s",
  "extra_config": {
    "router": {
      "disable_access_log": true,
      "return_error_msg": false
    },
    "telemetry/logging": {
      "level": "WARNING",
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/bench/{size}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://@@UPSTREAM_HOST@@:@@UPSTREAM_PORT@@"
          ],
          "url_pattern": "/bench/{size}",
          "encoding": "no-op",
          "extra_config": {
            "modifier/lua-backend": {
              "allow_open_libs": true,
              "pre": "local r = request.load(); local v = r:headers('X-Bench-In') or ''; r:headers('X-Bench-Script', string.upper(v) .. '-' .. string.len(v))"
            }
          }
        }
      ],
      "input_headers": [
        "X-Bench-In"
      ]
    }
  ]
}
