{
  "version": 3,
  "port": 8000,
  "timeout": "10s",
  "output_encoding": "no-op",
  "max_idle_connections_per_host": 512,
  "idle_connection_timeout": "300s",
  "extra_config": {
    "router": {
      "disable_access_log": true,
      "return_error_msg": false
    },
    "telemetry/logging": {
      "level": "WARNING",
      "stdout": true
    }
  },
  "endpoints": [
@@REPEAT 1000 SEP ,@@
    {"endpoint": "/r@@I@@/{size}", "method": "GET", "output_encoding": "no-op", "backend": [{"host": ["http://@@UPSTREAM_HOST@@:@@UPSTREAM_PORT@@"], "url_pattern": "/r@@I@@/{size}", "encoding": "no-op"}]}
@@END@@
  ]
}
