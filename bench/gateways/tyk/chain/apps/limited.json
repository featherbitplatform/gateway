{
  "name": "limited",
  "api_id": "limited",
  "org_id": "default",
  "active": true,
  "use_keyless": false,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "default_version": "Default",
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "proxy": {
    "listen_path": "/limited/",
    "target_url": "http://@@UPSTREAM_HOST@@:@@UPSTREAM_PORT@@/limited/",
    "strip_listen_path": true
  },
  "disable_rate_limit": false,
  "disable_quota": true,
  "do_not_track": true,
  "global_rate_limit": {
    "rate": 1,
    "per": 60
  },
  "auth": {
    "auth_header_name": "apikey"
  },
  "auth_configs": {
    "authToken": {
      "auth_header_name": "apikey"
    }
  }
}
