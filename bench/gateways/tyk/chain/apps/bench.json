{
  "name": "bench",
  "api_id": "bench",
  "org_id": "default",
  "active": true,
  "use_keyless": false,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "default_version": "Default",
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true,
        "global_headers": {
          "X-Bench-Added": "1",
          "X-Bench-Added2": "2"
        },
        "global_response_headers_remove": [
          "X-Bench-Remove"
        ]
      }
    }
  },
  "proxy": {
    "listen_path": "/bench/",
    "target_url": "http://@@UPSTREAM_HOST@@:@@UPSTREAM_PORT@@/bench/",
    "strip_listen_path": true
  },
  "disable_rate_limit": false,
  "disable_quota": true,
  "do_not_track": true,
  "auth": {
    "auth_header_name": "apikey"
  },
  "auth_configs": {
    "authToken": {
      "auth_header_name": "apikey"
    }
  },
  "global_rate_limit": {
    "rate": 100000000,
    "per": 60
  },
  "response_processors": [
    {
      "name": "header_injector",
      "options": {}
    }
  ]
}
