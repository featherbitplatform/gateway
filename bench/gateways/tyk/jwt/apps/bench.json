{
  "name": "bench",
  "api_id": "bench",
  "org_id": "default",
  "active": true,
  "use_keyless": false,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "default_version": "Default",
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "proxy": {
    "listen_path": "/bench/",
    "target_url": "http://@@UPSTREAM_HOST@@:@@UPSTREAM_PORT@@/bench/",
    "strip_listen_path": true
  },
  "disable_rate_limit": true,
  "disable_quota": true,
  "do_not_track": true,
  "enable_jwt": true,
  "jwt_signing_method": "hmac",
  "jwt_source": "@@JWT_SECRET_B64@@",
  "jwt_identity_base_field": "sub",
  "jwt_policy_field_name": "pol",
  "jwt_default_policies": [
    "bench"
  ],
  "auth_configs": {
    "jwt": {
      "auth_header_name": "Authorization"
    }
  }
}
