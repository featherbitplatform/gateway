{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // npm dependency CVE gate — fails on high/critical, reports the rest.
  // Same thresholds as the other scanners (see .github/workflows/security.yml
  // and dev/sast.ps1). Every allowlist entry needs a comment and a removal
  // condition — no silent suppression.
  "high": true,
  "allowlist": [
    // GHSA-vfj7-8cjw-p6xm (braces stack-exhaustion DoS on deeply nested glob
    // patterns): every published version is flagged (3.0.3 is latest), so no
    // upgrade exists; pulled in via chokidar 3 (@docusaurus/core and
    // webpack-dev-server), which only expands the file-watch globs written in
    // this repo's docusaurus config at docs build/dev time — not
    // attacker-reachable, never in the shipped binary/image. Remove once
    // braces ships a fix (or docusaurus moves to chokidar 4+, which dropped it).
    "GHSA-vfj7-8cjw-p6xm"
  ]
}
