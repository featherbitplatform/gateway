{
  "name": "featherbit-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end suite: admin API, data plane, and the web UI. See E2E_TESTBOOK.md.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:all": "npm run build:ui && npm run build:gateway && playwright test",
    "build:ui": "npm --prefix ../ui run build",
    "build:gateway": "cargo build --release --manifest-path ../Cargo.toml",
    "setup": "npm install && playwright install chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jose": "^6.2.3",
    "ldapjs": "^3.0.7"
  }
}
